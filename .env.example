# Baked into the static site at build time. Safe to expose: this is the Supabase anon key.
# Never put the service-role key in a NEXT_PUBLIC_ variable.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Set to 1 only when attorney login, the profile editor, admin review, and public profiles should be reachable.
NEXT_PUBLIC_PHASE2=

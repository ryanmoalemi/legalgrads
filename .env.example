# Baked into the static site at build time by .github/workflows/pages.yml.
# NEXT_PUBLIC_SUPABASE_ANON_KEY is the publishable key (sb_publishable_…).
# Never put a secret key (sb_secret_…) or the service-role key in a NEXT_PUBLIC_ variable.
NEXT_PUBLIC_SUPABASE_URL=https://qlhwojjdsonjxfeoiqww.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Set to 1 only when attorney login, the profile editor, admin review, and public profiles should be reachable.
NEXT_PUBLIC_PHASE2=
